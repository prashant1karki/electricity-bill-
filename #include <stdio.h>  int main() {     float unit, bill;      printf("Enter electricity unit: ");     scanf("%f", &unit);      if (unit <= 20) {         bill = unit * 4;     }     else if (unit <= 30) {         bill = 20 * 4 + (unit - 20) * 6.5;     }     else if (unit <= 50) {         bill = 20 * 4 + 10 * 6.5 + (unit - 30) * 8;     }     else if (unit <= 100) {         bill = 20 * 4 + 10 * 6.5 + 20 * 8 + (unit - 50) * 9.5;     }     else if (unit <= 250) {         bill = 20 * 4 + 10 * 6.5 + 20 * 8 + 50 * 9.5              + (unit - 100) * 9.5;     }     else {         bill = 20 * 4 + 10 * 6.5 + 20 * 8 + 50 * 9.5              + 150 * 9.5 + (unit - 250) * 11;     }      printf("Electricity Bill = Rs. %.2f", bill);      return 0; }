#include <stdio.h>
#define mc 150
int main() {
    float unit, bill;

    printf("Enter electricity unit: ");
    scanf("%f", &unit);

    if (unit <= 20) {
        bill = unit * 4;
    }
    else if (unit <= 30) {
        bill = 20 * 4 + (unit - 20) * 6.5+mc;
    }
    else if (unit <= 50) {
        bill = 20 * 4 + 10 * 6.5 + (unit - 30) * 8+mc;
    }
    else if (unit <= 100) {
        bill = 20 * 4 + 10 * 6.5 + 20 * 8 + (unit - 50) * 9.5+mc;
    }
    else if (unit <= 250) {
        bill = 20 * 4 + 10 * 6.5 + 20 * 8 + 50 * 9.5
             + (unit - 100) * 9.5+mc;
    }
    else {
        bill = 20 * 4 + 10 * 6.5 + 20 * 8 + 50 * 9.5
             + 150 * 9.5 + (unit - 250) * 11+mc;
    }

    printf("Electricity Bill = Rs. %.2f", bill);

    return 0;
}
